<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="ASP.NET Core y Blazor">
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Persistencia">
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <!-- Claves de Data Protection en PostgreSQL, para que sobrevivan a los despliegues (Logistica.Api). -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Caché">
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Tiempo real">
    <!-- CU-66: backplane de SignalR sobre Valkey, para que el Worker publique en las salas que atiende la API. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Correo">
    <!-- CU-62: envío por SMTP (Mailpit en desarrollo). MailKit es el cliente que recomienda
         Microsoft en lugar de System.Net.Mail.SmtpClient. -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- MimeKit trae la 10.0.0, con avisos de seguridad (GHSA-2fmv-rv2c-59x7 y GHSA-846f-f764-76mx): se fija la versión
         de servicio de .NET que usa el resto de la solución. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Observabilidad">
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Etiquetas PDF (CU-15)">
    <PackageVersion Include="QuestPDF" Version="2026.9.1" />
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup Label="Pruebas">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- CU-66: cliente SignalR para probar las salas por operador del tablero. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Opcional 7.2: pruebas de extremo a extremo desde un navegador real (tests/Logistica.E2ETests). -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.4" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
