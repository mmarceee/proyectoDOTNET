# Copiar como .env y completar. El archivo .env está excluido de Git.

# PostgreSQL
POSTGRES_DB=logistica
POSTGRES_USER=logistica
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5432

# Valkey
VALKEY_PORT=6379

# RabbitMQ
RABBITMQ_USER=logistica
RABBITMQ_PASSWORD=cambiar-esta-clave
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Mailpit (SMTP y página web con los correos de desarrollo)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Aspire Dashboard (UI y recepción OTLP)
ASPIRE_DASHBOARD_PORT=18888
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Puerto de la Api en el contenedor
API_PORT=8080
