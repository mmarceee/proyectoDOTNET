# Copiar como .env y completar. El archivo .env está excluido de Git.

# PostgreSQL
POSTGRES_DB=VoluptasExpress
POSTGRES_USER=Voluptas
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5432

# Valkey
VALKEY_PORT=6379

# RabbitMQ
RABBITMQ_USER=Voluptas
RABBITMQ_PASSWORD=cambiar-esta-clave
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Mailpit (SMTP y página web con los correos de desarrollo)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Aspire Dashboard (UI y recepción OTLP)
ASPIRE_DASHBOARD_PORT=18888
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Puerto de la Api en el contenedor
API_PORT=8080

# Clave para firmar los enlaces del seguimiento público (CU-60): al menos 32 bytes en Base64.
# Generar una con: openssl rand -base64 32
SEGUIMIENTO_CLAVE_TOKEN=

# CU-63: clave exclusiva para cifrar los secretos de avisos, exactamente 32 bytes en Base64.
# Generar otra clave con: openssl rand -base64 32
# Conservarla entre reinicios y despliegues; API y Worker deben usar la misma.
AVISOS_CLAVE_CIFRADO=

# CU-62: dirección pública del sitio, para el enlace de seguimiento de los correos al destinatario.
# Sin valor, Docker Compose usa http://localhost:${API_PORT}.
URL_PUBLICA=

# CU-62: dirección desde la que salen los correos. En producción, una dirección verificada en el proveedor SMTP.
# Sin valor, se usa avisos@logistica.local (Mailpit acepta cualquiera).
CORREO_REMITENTE=
