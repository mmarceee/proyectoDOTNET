<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- La sirve Logistica.Api en /seguimiento/ (ADR-0001, addendum 5). Sin OverrideHtmlAssetPlaceholders:
         en .NET 10 publica el index.html fuera de StaticWebAssetBasePath y choca con las otras apps. -->
    <StaticWebAssetBasePath>seguimiento</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Logistica.Http.Contracts\Logistica.Http.Contracts.csproj" />
  </ItemGroup>

</Project>
