@page "/{Token}"
@using System.Net
@using Logistica.Http.Contracts.Seguimiento
@inject HttpClient Http

@* CU-60: lo que ve la destinataria al abrir su enlace, con la marca del operador. Sin usuario ni contraseña: el token
   del enlace es la única credencial. Un enlace alterado y uno de un envío que no existe se ven igual (A1 y A2). *@

<PageTitle>@(seguimiento is null ? "Seguimiento de envíos" : $"Envío {seguimiento.Numero}")</PageTitle>

@if (estado == Estado.Cargando)
{
    <p class="text-muted">Buscando tu envío…</p>
}
else if (estado == Estado.NoValido)
{
    <h1 class="h4">Enlace no válido</h1>
    <p class="text-muted">Revisá que el enlace esté completo, tal como lo recibiste.</p>
}
else if (estado == Estado.Demasiadas)
{
    <h1 class="h4">Demasiadas consultas</h1>
    <p class="text-muted">Esperá un minuto y volvé a intentar.</p>
}
else if (estado == Estado.Error)
{
    <h1 class="h4">No pudimos cargar tu envío</h1>
    <p class="text-muted">Probá de nuevo en unos minutos.</p>
}
else if (seguimiento is not null)
{
    <header class="rounded-3 p-3 mb-4 text-white" style="background-color: @seguimiento.Marca.ColorPrimario">
        <div class="small opacity-75">@seguimiento.Marca.Operador</div>
        <h1 class="h4 mb-0">@seguimiento.Estado</h1>
    </header>

    <p>Hola, <strong>@seguimiento.NombreDePila</strong>. Tu envío <strong>@seguimiento.Numero</strong> va a @seguimiento.Localidad.</p>

    @if (seguimiento.VentanaEstimada is not null)
    {
        <div class="alert alert-light border" role="status">
            <div class="small text-muted">Entrega estimada</div>
            <div class="fw-semibold">@seguimiento.VentanaEstimada</div>
        </div>
    }

    @* CU-61: elegir otra fecha y franja. Las opciones ya respetan la zona y la anticipación del operador (H3). *@
    @if (mensaje is not null)
    {
        <div class="alert alert-success" role="status">@mensaje</div>
    }
    @if (seguimiento.PuedeReprogramar)
    {
        @if (opciones is null)
        {
            <button type="button" class="btn btn-outline-primary mb-3" @onclick="VerOpcionesAsync" disabled="@ocupado">
                ¿No vas a estar? Elegí otro día
            </button>
        }
        else
        {
            <section class="card mb-3" aria-labelledby="reprogramar-titulo">
                <div class="card-body">
                    <h2 id="reprogramar-titulo" class="h6">Elegí cuándo querés recibirlo</h2>
                    @if (error is not null)
                    {
                        <div class="alert alert-danger" role="alert">@error</div>
                    }
                    @if (opciones.Count == 0)
                    {
                        <p class="text-muted mb-0">No hay fechas disponibles en los próximos días. Comunicate con el comercio.</p>
                    }
                    else
                    {
                        <select class="form-select mb-3" aria-label="Fecha y horario" @bind="elegida">
                            @foreach (var opcion in opciones)
                            {
                                <option value="@Clave(opcion)">@opcion.Texto</option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary" @onclick="ConfirmarAsync" disabled="@ocupado">Confirmar</button>
                        <button type="button" class="btn btn-link" @onclick="() => opciones = null">Cancelar</button>
                    }
                </div>
            </section>
        }
    }

    <h2 class="h6 mt-4">Historial</h2>
    <ol class="list-group list-group-numbered mb-4">
        @foreach (var hito in seguimiento.Historial.Reverse())
        {
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <span class="ms-2 me-auto">@hito.Estado</span>
                <span class="text-muted small">@hito.OcurridoEn.ToLocalTime().ToString("dd/MM HH:mm")</span>
            </li>
        }
    </ol>

    @if (seguimiento.Marca.EmailContacto is not null || seguimiento.Marca.TelefonoContacto is not null)
    {
        <footer class="small text-muted border-top pt-2" style="border-color: @seguimiento.Marca.ColorSecundario !important">
            ¿Dudas? @seguimiento.Marca.Operador · @seguimiento.Marca.EmailContacto @seguimiento.Marca.TelefonoContacto
        </footer>
    }
}

@code {
    private enum Estado { Cargando, Listo, NoValido, Demasiadas, Error }

    [Parameter] public string Token { get; set; } = "";

    private Estado estado = Estado.Cargando;
    private SeguimientoPublicoResponse? seguimiento;

    // CU-61
    private List<OpcionReprogramacionResponse>? opciones;
    private string? elegida;
    private string? error;
    private string? mensaje;
    private bool ocupado;

    private string Url => $"/api/seguimiento/{Uri.EscapeDataString(Token)}/reprogramacion";

    private static string Clave(OpcionReprogramacionResponse o) => $"{o.Fecha:yyyy-MM-dd}|{o.FranjaId}";

    private async Task VerOpcionesAsync()
    {
        ocupado = true; error = null; mensaje = null;
        try
        {
            var respuesta = await Http.GetFromJsonAsync<OpcionesReprogramacionResponse>(Url);
            opciones = respuesta?.Opciones.ToList() ?? [];
            elegida = opciones.Count > 0 ? Clave(opciones[0]) : null;
        }
        catch (HttpRequestException)
        {
            opciones = [];
            error = "No pudimos cargar las fechas. Probá de nuevo en unos minutos.";
        }
        finally { ocupado = false; }
    }

    private async Task ConfirmarAsync()
    {
        var opcion = opciones?.SingleOrDefault(o => Clave(o) == elegida);
        if (opcion is null) return;

        ocupado = true; error = null;
        try
        {
            var respuesta = await Http.PostAsJsonAsync(Url, new SolicitarReprogramacionRequest(opcion.Fecha, opcion.FranjaId));
            if (respuesta.IsSuccessStatusCode)
            {
                opciones = null;
                mensaje = $"Listo: tu envío se va a entregar el {opcion.Texto}.";
                await CargarAsync();
            }
            else
            {
                // A1, A2 o A3: el servidor explica el motivo (ProblemDetails).
                var problema = await respuesta.Content.ReadFromJsonAsync<ProblemaResponse>();
                error = respuesta.StatusCode == HttpStatusCode.TooManyRequests
                    ? "Demasiados intentos. Esperá un minuto y volvé a probar."
                    : problema?.Detail ?? "No se pudo reprogramar. Probá con otra fecha.";
            }
        }
        catch (HttpRequestException)
        {
            error = "No pudimos reprogramar. Probá de nuevo en unos minutos.";
        }
        finally { ocupado = false; }
    }

    private sealed record ProblemaResponse(string? Title, string? Detail);

    protected override Task OnParametersSetAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        estado = Estado.Cargando;
        try
        {
            var respuesta = await Http.GetAsync($"/api/seguimiento/{Uri.EscapeDataString(Token)}");
            if (respuesta.IsSuccessStatusCode)
            {
                seguimiento = await respuesta.Content.ReadFromJsonAsync<SeguimientoPublicoResponse>();
                estado = seguimiento is null ? Estado.Error : Estado.Listo;
            }
            else
            {
                estado = respuesta.StatusCode switch
                {
                    HttpStatusCode.NotFound => Estado.NoValido,
                    HttpStatusCode.TooManyRequests => Estado.Demasiadas,
                    _ => Estado.Error,
                };
            }
        }
        catch (HttpRequestException)
        {
            estado = Estado.Error;
        }
    }
}
