@page "/avisos"
@page "/integraciones/avisos"
@using Logistica.Http.Contracts.Avisos
@implements IDisposable

<PageTitle>Avisos automáticos · Integraciones</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <p class="text-muted small mb-1">Integraciones</p>
        <h1>Avisos automáticos</h1>
        <p class="text-muted mb-0">Conectá tu sistema para recibir novedades de los envíos del operador seleccionado.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" disabled="@_ocupado" @onclick="CargarAsync">Actualizar</button>
        <button type="button" class="btn btn-primary" disabled="@(_ocupado || _secreto is not null || _mostrarFormulario)"
                @onclick="AbrirFormulario">Nueva suscripción</button>
    </div>
</div>

<p class="small text-muted mb-4">Esta configuración está dirigida a la persona que administra la integración de tu sistema.</p>
<nav class="nav nav-tabs mb-4" aria-label="Avisos automáticos">
    <a class="nav-link active" aria-current="page" href="integraciones/avisos">Suscripciones</a>
    <a class="nav-link" href="integraciones/avisos/historial">Historial</a>
</nav>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
@if (_mensaje is not null)
{
    <div class="alert alert-success" role="status">@_mensaje</div>
}
@if (_elegirOperador)
{
    <p><a href="/cuenta/operador?ReturnUrl=%2Fportal%2Fintegraciones%2Favisos">Elegir operador</a></p>
}

@if (_resultadoPrueba is not null)
{
    <section class="alert @(_resultadoPrueba.Exitosa ? "alert-success" : "alert-danger")" role="status" aria-labelledby="titulo-prueba">
        <h2 id="titulo-prueba" class="h5">@(_resultadoPrueba.Exitosa ? "Prueba recibida correctamente" : "La prueba no fue exitosa")</h2>
        <p class="text-break mb-1">@_urlPrueba</p>
        @if (_resultadoPrueba.CodigoRespuesta is int codigo)
        {
            <p class="mb-1">Respuesta del receptor: <strong>HTTP @codigo</strong></p>
        }
        @if (_resultadoPrueba.Error is not null)
        {
            <p class="mb-1">@_resultadoPrueba.Error</p>
        }
        <p class="small mb-0">Identificador de prueba: @_resultadoPrueba.MensajeId</p>
    </section>
}

@if (_secreto is not null)
{
    <section class="card border-warning mb-4" aria-labelledby="titulo-secreto">
        <div class="card-body">
            <h2 id="titulo-secreto" class="h5">Guardá la clave de firma</h2>
            <p>Se muestra una sola vez. Copialo y guardalo en la configuración segura de tu sistema.
                Esta clave permite a tu sistema comprobar el origen de los avisos. Si la perdés, tendrás que generar una nueva.</p>
            <label for="secreto-firma" class="form-label">Clave de firma</label>
            <input id="secreto-firma" class="form-control font-monospace mb-3" readonly autocomplete="off"
                   spellcheck="false" value="@_secreto.SecretoFirma" aria-describedby="ayuda-secreto" />
            <p id="ayuda-secreto" class="small text-muted">Seleccioná el valor para copiarlo. Al cerrar este aviso no podrás volver a consultarlo.</p>
            <details class="mb-3">
                <summary>Cómo verificar la firma</summary>
                <ol class="mt-2">
                    <li>Decodificá esta clave de Base64.</li>
                    <li>Tomá la fecha de <code>X-Aviso-Fecha</code>, agregá un punto y el cuerpo JSON exacto recibido.</li>
                    <li>Calculá HMAC-SHA256 con esa clave y compará el hexadecimal con <code>X-Aviso-Firma</code>, después de <code>v1=</code>.</li>
                    <li>Rechazá fechas con más de 5 minutos de diferencia respecto de tu reloj y usá el identificador del mensaje para detectar duplicados.</li>
                </ol>
            </details>
            <button type="button" class="btn btn-primary" @onclick="CerrarSecreto">Ya guardé la clave</button>
        </div>
    </section>
}

@if (_mostrarFormulario)
{
    <section class="card mb-4" aria-labelledby="titulo-nueva">
        <div class="card-body">
            <h2 id="titulo-nueva" class="h5">Nueva suscripción</h2>
            <EditForm Model="_formulario" OnValidSubmit="CrearAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <fieldset disabled="@_ocupado">
                    <div class="mb-3">
                        <label for="url-destino" class="form-label">URL del sistema receptor</label>
                        <InputText id="url-destino" type="url" class="form-control" placeholder="https://tu-sistema.com/avisos"
                                   @bind-Value="_formulario.UrlDestino" aria-describedby="ayuda-url-destino" />
                        <div id="ayuda-url-destino" class="form-text">Dirección HTTPS proporcionada por quien administra tu sistema.</div>
                        <ValidationMessage For="() => _formulario.UrlDestino" />
                    </div>
                    <fieldset class="mb-3">
                        <legend class="h6">Tipos de evento</legend>
                        <div class="form-check">
                            <InputCheckbox id="evento-estado" class="form-check-input" @bind-Value="_formulario.CambioDeEstado" />
                            <label for="evento-estado" class="form-check-label">Cambio de estado</label>
                        </div>
                        <div class="form-check">
                            <InputCheckbox id="evento-fallida" class="form-check-input" @bind-Value="_formulario.EntregaFallida" />
                            <label for="evento-fallida" class="form-check-label">Entrega fallida</label>
                        </div>
                        <div class="form-check">
                            <InputCheckbox id="evento-devolucion" class="form-check-input" @bind-Value="_formulario.Devolucion" />
                            <label for="evento-devolucion" class="form-check-label">Devolución</label>
                        </div>
                    </fieldset>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">@(_ocupado ? "Guardando…" : "Crear suscripción")</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </fieldset>
            </EditForm>
        </div>
    </section>
}

@if (_confirmacion is not null)
{
    <section class="alert alert-warning" aria-labelledby="titulo-confirmacion">
        <h2 id="titulo-confirmacion" class="h5">@(_regenerar ? "¿Generar una nueva clave de firma?" : "Desactivar la suscripción")</h2>
        <p class="text-break">@_confirmacion.UrlDestino</p>
        <p>@(_regenerar
            ? "La clave actual dejará de ser válida inmediatamente. Coordiná el cambio con quien administra tu sistema: hasta actualizarla, tu sistema no podrá verificar los nuevos avisos."
            : "Esta suscripción dejará de recibir nuevos avisos. Se conservará su configuración.")</p>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-warning" disabled="@_ocupado" @onclick="ConfirmarAccionAsync">
                @(_ocupado ? "Guardando…" : _regenerar ? "Generar y reemplazar la clave actual" : "Confirmar desactivación")
            </button>
            <button type="button" class="btn btn-outline-secondary" disabled="@_ocupado" @onclick="CancelarAccion">Cancelar</button>
        </div>
    </section>
}

@if (_seguridad is not null && _confirmacion is null)
{
    <section class="card mb-4" aria-labelledby="titulo-configuracion">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                <div>
                    <h2 id="titulo-configuracion" class="h5">Configuración de la suscripción</h2>
                    <p class="text-break text-muted mb-0">@_seguridad.UrlDestino</p>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm align-self-start" disabled="@_ocupado"
                        @onclick="CerrarConfiguracion">Cerrar configuración</button>
            </div>
            <h3 class="h6">Seguridad de los avisos</h3>
            <p>Los avisos se firman con una clave compartida con tu sistema. Esa firma permite verificar que provienen de la plataforma y que su contenido no fue alterado.</p>
            <p class="small text-muted">La clave se entregó al configurar la suscripción y no se puede volver a consultar.</p>
            <details @key="_seguridad.Id" class="border rounded p-3">
                <summary>Cambiar la clave de firma</summary>
                <div class="mt-3">
                    <p>Usá esta opción si perdiste la clave, sospechás que alguien más la obtuvo o necesitás renovarla por seguridad.</p>
                    <p class="small">El cambio requiere actualizar la configuración del sistema receptor. Coordiná ese paso antes de continuar.</p>
                    <button type="button" class="btn btn-outline-secondary" disabled="@AccionesBloqueadas"
                            @onclick="() => PedirConfirmacion(_seguridad, true)">Generar nueva clave de firma</button>
                </div>
            </details>
            @if (_seguridad.Activa)
            {
                <div class="border-top mt-4 pt-3">
                    <h3 class="h6">Desactivar la suscripción</h3>
                    <p class="small text-muted">Dejá de enviar nuevos avisos a esta dirección. Se conservará su configuración.</p>
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@AccionesBloqueadas"
                            @onclick="() => PedirConfirmacion(_seguridad, false)">Desactivar suscripción</button>
                </div>
            }
        </div>
    </section>
}

@if (_cargando)
{
    <p role="status">Cargando suscripciones…</p>
}
else if (_suscripciones is not null)
{
    @if (_suscripciones.Count == 0)
    {
        <p>No hay suscripciones para tu comercio con este operador. Creá una para configurar los avisos.</p>
    }
    else
    {
        <p class="small text-muted">«Enviar prueba» envía una sola vez un aviso firmado con datos ficticios. Tu sistema debe reconocerlo como prueba.</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <caption>Suscripciones de avisos del operador seleccionado</caption>
                <thead><tr><th scope="col">Dirección</th><th scope="col">Eventos</th><th scope="col">Estado</th><th scope="col">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var suscripcion in _suscripciones)
                    {
                        <tr @key="suscripcion.Id">
                            <th scope="row" class="text-break">@suscripcion.UrlDestino</th>
                            <td>@string.Join(", ", suscripcion.TiposEvento.Select(NombreEvento))</td>
                            <td><span class="badge @(suscripcion.Activa ? "text-bg-success" : "text-bg-secondary")">@(suscripcion.Activa ? "Activa" : "Inactiva")</span></td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(AccionesBloqueadas || !suscripcion.Activa)"
                                            @onclick="() => EnviarPruebaAsync(suscripcion)">@(_probando == suscripcion.Id ? "Enviando…" : "Enviar prueba")</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@AccionesBloqueadas"
                                            @onclick="() => AbrirConfiguracion(suscripcion)">Configurar seguridad</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
