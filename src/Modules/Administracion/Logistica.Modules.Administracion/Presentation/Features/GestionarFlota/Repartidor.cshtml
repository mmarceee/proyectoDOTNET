@page "/backoffice/flota/repartidores/{id:guid}"
@model Logistica.Modules.Administracion.Presentation.Features.GestionarFlota.RepartidorModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Repartidor.Nombre;
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <h1 class="h3 mb-0">
        @Model.Repartidor.Nombre · @Model.Repartidor.Documento
        @if (Model.Repartidor.Activo)
        {
            <span class="badge text-bg-success align-middle">Activo</span>
        }
        else
        {
            <span class="badge text-bg-secondary align-middle">Inactivo</span>
        }
    </h1>
    <a href="/backoffice/flota" class="btn btn-outline-secondary">Volver a la flota</a>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if (Model.Mensaje is not null)
{
    <div class="alert alert-success" role="status">@Model.Mensaje</div>
}

<p class="text-muted">Usuario de la app: @(Model.Repartidor.TieneUsuario ? "vinculado" : "sin usuario (se vincula en Usuarios)").</p>

<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h6">Modificar</h2>
        <form method="post" asp-page-handler="Modificar">
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
                <div class="form-text">El documento no se puede cambiar.</div>
            </div>
            <button type="submit" class="btn btn-outline-primary">Guardar cambios</button>
        </form>
    </div>

    @if (Model.Repartidor.Activo)
    {
        <div class="col-lg-6">
            <h2 class="h6">Desactivar</h2>
            <p class="text-muted small mb-2">No se ofrece para rutas nuevas. No se puede mientras tenga una ruta sin finalizar.</p>
            <form method="post" asp-page-handler="Desactivar">
                <button type="submit" class="btn btn-outline-danger">Desactivar repartidor</button>
            </form>
        </div>
    }
</div>
