@page "/cuenta/salir"
@model Logistica.Modules.Administracion.Presentation.Features.IniciarSesion.SalirModel
@{
    Layout = Model.Repartidor ? "/Pages/Shared/_LayoutRepartidor.cshtml" : Model.Portal ? "/Pages/Shared/_LayoutPortal.cshtml" : "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cerrar sesión";
}
<div class="text-center">
    <h1 class="h3 mb-4">Cerrar sesión</h1>
    <p>¿Querés cerrar la sesión de @User.Identity?.Name?</p>
    <form method="post" asp-antiforgery="true">
        <input asp-for="Portal" type="hidden" />
        <input asp-for="Repartidor" type="hidden" />
        <button class="btn btn-danger" type="submit">Cerrar sesión</button>
        <a class="btn btn-outline-secondary" href="@(Model.Repartidor ? "/repartidor/" : Model.Portal ? "/portal/" : "/backoffice")">Cancelar</a>
    </form>
</div>
