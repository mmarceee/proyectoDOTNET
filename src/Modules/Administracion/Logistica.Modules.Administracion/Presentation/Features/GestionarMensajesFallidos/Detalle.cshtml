@page "/backoffice/mensajes-fallidos/{id:guid}"
@model Logistica.Modules.Administracion.Presentation.Features.GestionarMensajesFallidos.DetalleModel

@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Mensaje fallido";
    var m = Model.Detalle.Resumen;
    var pendiente = m.Estado == "Pendiente";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <h1 class="h3 mb-0">Mensaje <code>@m.Tipo</code></h1>
    <a href="/backoffice/mensajes-fallidos" class="btn btn-outline-secondary">Volver al listado</a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All" role="alert"></div>
}

<dl class="row">
    <dt class="col-sm-3">Identificador</dt>
    <dd class="col-sm-9"><code>@Model.Detalle.MessageId</code></dd>
    <dt class="col-sm-3">Cola de origen</dt>
    <dd class="col-sm-9"><code>@m.ColaOrigen</code></dd>
    <dt class="col-sm-3">Ocurrió</dt>
    <dd class="col-sm-9">@m.OcurridoEn.ToString("dd/MM/yyyy HH:mm:ss") UTC</dd>
    <dt class="col-sm-3">Intentos</dt>
    <dd class="col-sm-9">@m.Intentos</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@m.Estado</dd>
    @if (Model.Detalle.ResueltoPor is not null)
    {
        <dt class="col-sm-3">Resuelto por</dt>
        <dd class="col-sm-9">@Model.Detalle.ResueltoPor, el @Model.Detalle.ResueltoEn?.ToString("dd/MM/yyyy HH:mm") UTC</dd>
    }
    @if (Model.Detalle.MotivoDescarte is not null)
    {
        <dt class="col-sm-3">Motivo del descarte</dt>
        <dd class="col-sm-9">@Model.Detalle.MotivoDescarte</dd>
    }
</dl>

<h2 class="h5">Historial de errores</h2>
<ul>
    @foreach (var linea in Model.Detalle.Historial)
    {
        <li>@linea</li>
    }
</ul>

<h2 class="h5">Contenido</h2>
<pre class="bg-light border rounded p-3"><code>@Model.ContenidoLegible()</code></pre>

@if (pendiente)
{
    <div class="d-flex flex-wrap gap-4 mt-4">
        <form method="post" asp-page-handler="Reintentar">
            <button type="submit" class="btn btn-primary">Reintentar</button>
        </form>

        <form method="post" asp-page-handler="Descartar" class="flex-grow-1">
            <label asp-for="Motivo" class="form-label">Motivo del descarte</label>
            <textarea asp-for="Motivo" class="form-control mb-2" rows="2" maxlength="500" required></textarea>
            <span asp-validation-for="Motivo" class="text-danger d-block mb-2"></span>
            <button type="submit" class="btn btn-outline-danger">Descartar</button>
        </form>
    </div>
}
