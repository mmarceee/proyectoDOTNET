@page "/cuenta/activar"
@model Logistica.Modules.Administracion.Presentation.Features.ActivarCuenta.ActivarModel
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Activar la cuenta";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="h3 mb-4">Activar la cuenta</h1>

        @if (Model.Activada)
        {
            <div class="alert alert-success" role="status">Tu cuenta está activa.</div>
            <a href="@Model.Ingreso" class="btn btn-primary w-100">Ingresar</a>
        }
        else if (Model.EnlaceInvalido)
        {
            <div class="alert alert-danger" role="alert">
                El enlace venció o ya se usó. Pedile al administrador de tu operador que te reenvíe la invitación.
            </div>
        }
        else
        {
            <p class="text-muted">Elegí tu contraseña: al menos 6 caracteres, con mayúscula, minúscula, número y símbolo.</p>
            <div asp-validation-summary="All" class="text-danger"></div>

            <form method="post">
                <input type="hidden" asp-for="Usuario" />
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label">Contraseña</label>
                    <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                </div>

                <div class="mb-3">
                    <label asp-for="Confirmacion" class="form-label">Repetí la contraseña</label>
                    <input asp-for="Confirmacion" class="form-control" autocomplete="new-password" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Activar</button>
            </form>
        }
    </div>
</div>
