@page "/backoffice/envios/{numero}"
@model Logistica.Modules.Envios.Presentation.Features.ConsultarDetalleEnvio.DetalleModel

@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    var envio = Model.Detalle;
    ViewData["Title"] = $"Envío {envio.Numero}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-2">Envío @envio.Numero</h1>
        <span class="badge @EstadoEnvioBadge.Clase(envio.Estado)">@EstadoEnvioTexto.Mostrar(envio.Estado)</span>
        <span class="text-muted ms-2">Fecha de alta: @Model.MostrarFecha(envio.CreadoEn)</span>
    </div>
    <a href="@Model.UrlVolver" class="btn btn-outline-secondary">Volver al listado</a>
</div>

<section class="card mb-4" aria-labelledby="resumen-titulo">
    <div class="card-body p-4">
        <h2 id="resumen-titulo" class="h5 mb-3">Resumen del envío</h2>
        <dl class="row g-3 mb-0">
            <div class="col-12 col-sm-4"><dt class="text-muted fw-normal">Bultos</dt><dd class="mb-0 fs-5 fw-semibold">@envio.Bultos.Count</dd></div>
            <div class="col-12 col-sm-4"><dt class="text-muted fw-normal">Peso declarado total</dt><dd class="mb-0 fs-5 fw-semibold">@envio.Bultos.Sum(b => b.PesoKg).ToString("0.##") kg</dd></div>
            <div class="col-12 col-sm-4"><dt class="text-muted fw-normal">Tarifa total</dt><dd class="mb-0 fs-5 fw-semibold">@envio.MontoTarifa.ToString("0.00")</dd></div>
        </dl>
    </div>
</section>

<div class="row g-3 mb-4">
    <section class="col-12 col-lg-6" aria-labelledby="destinatario-titulo">
        <div class="card h-100">
            <div class="card-body p-4">
                <h2 id="destinatario-titulo" class="h5 mb-3">Destinatario</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@envio.Destinatario.Nombre</dd>
                    <dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">@envio.Destinatario.Telefono</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8 text-break">@(envio.Destinatario.Email ?? "Sin informar")</dd>
                    <dt class="col-sm-4">Documento</dt><dd class="col-sm-8">@(envio.Destinatario.Documento ?? "Sin informar")</dd>
                </dl>
            </div>
        </div>
    </section>
    <section class="col-12 col-lg-6" aria-labelledby="direccion-titulo">
        <div class="card h-100">
            <div class="card-body p-4">
                <h2 id="direccion-titulo" class="h5 mb-3">Dirección de entrega</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Dirección</dt><dd class="col-sm-8">@envio.Direccion.Calle @envio.Direccion.Numero</dd>
                    <dt class="col-sm-4">Localidad</dt><dd class="col-sm-8">@envio.Direccion.Localidad</dd>
                    <dt class="col-sm-4">Departamento</dt><dd class="col-sm-8">@envio.Direccion.Departamento</dd>
                    <dt class="col-sm-4">Código postal</dt><dd class="col-sm-8">@envio.Direccion.CodigoPostal</dd>
                    <dt class="col-sm-4">Referencia</dt><dd class="col-sm-8">@(envio.Direccion.Referencia ?? "Sin informar")</dd>
                </dl>
            </div>
        </div>
    </section>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-xl-9">
<section class="card h-100" aria-labelledby="bultos-titulo">
    <div class="card-body p-4">
    <h2 id="bultos-titulo" class="h5 mb-3">Bultos (@envio.Bultos.Count)</h2>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Código</th>
                    <th scope="col">Peso (kg)</th>
                    <th scope="col">Largo × ancho × alto (cm)</th>
                    <th scope="col" class="text-end">Tarifa</th>
                    <th scope="col">Recepción</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bulto in envio.Bultos)
                {
                    <tr>
                        <td>@bulto.Codigo</td>
                        <td>@bulto.PesoKg.ToString("0.##")</td>
                        <td>@bulto.LargoCm.ToString("0.##") × @bulto.AnchoCm.ToString("0.##") × @bulto.AltoCm.ToString("0.##")</td>
                        <td class="text-end">@bulto.MontoTarifa.ToString("0.00")</td>
                        <td><span class="badge @(bulto.Recibido ? "text-bg-success" : "text-bg-secondary")">@(bulto.Recibido ? "Recibido" : "Pendiente")</span></td>
                        <td>
                            @if (bulto.PuedeRecepcionar)
                            {
                                <a href="@Model.UrlRecepcion(bulto.Codigo)" class="btn btn-outline-primary btn-sm"
                                   aria-label="Recepcionar bulto @bulto.Codigo">Recepcionar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th scope="row" colspan="3">Tarifa total</th>
                    <td class="text-end fw-bold">@envio.MontoTarifa.ToString("0.00")</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
    </div>
</section>
    </div>
    <div class="col-12 col-xl-3">
<section class="card h-100" aria-labelledby="tarifa-titulo">
    <div class="card-body p-4">
    <h2 id="tarifa-titulo" class="h5 mb-3">Cuadro tarifario aplicado</h2>
    @if (envio.VersionTarifario is { } version)
    {
        <p class="mb-2 fw-semibold">Versión @version.Numero</p>
        <details class="text-muted small text-break"><summary>Identificador de la versión</summary><p class="mt-2 mb-0">@version.Id</p></details>
    }
    else
    {
        <p class="text-muted mb-0">No se registró una versión tarifaria al admitir este envío.</p>
    }
    </div>
</section>
    </div>
</div>

<section class="card mb-4" aria-labelledby="intentos-titulo">
    <div class="card-body p-4">
    <h2 id="intentos-titulo" class="h5 mb-3">Intentos de entrega</h2>
    @if (envio.Intentos.Count == 0)
    {
        <p>No hay intentos de entrega registrados.</p>
    }
    @foreach (var intento in envio.Intentos)
    {
        <article class="card mb-3">
            <div class="card-body">
                <h3 class="h5">Intento @intento.NumeroIntento · @intento.Resultado</h3>
                <p>Fecha: @Model.MostrarFecha(intento.FechaHora)</p>
                @if (intento.MotivoNoEntregaId is { } motivo)
                {
                    <p>Motivo de no entrega (identificador): @motivo</p>
                }
                @if (!string.IsNullOrWhiteSpace(intento.Observaciones))
                {
                    <p>@intento.Observaciones</p>
                }
                @if (intento.Evidencia is { } evidencia)
                {
                    <dl class="row">
                        <dt class="col-sm-4">Receptor</dt><dd class="col-sm-8">@(evidencia.NombreReceptor ?? "Sin informar")</dd>
                        <dt class="col-sm-4">Documento</dt><dd class="col-sm-8">@(evidencia.DocumentoReceptor ?? "Sin informar")</dd>
                        <dt class="col-sm-4">Ubicación</dt><dd class="col-sm-8">@evidencia.Latitud, @evidencia.Longitud</dd>
                        <dt class="col-sm-4">Capturada</dt><dd class="col-sm-8">@Model.MostrarFecha(evidencia.CapturadaEn)</dd>
                    </dl>
                    <div class="d-flex flex-wrap gap-2">
                        @if (evidencia.FirmaArchivoId is { } firmaId)
                        {
                            <a class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener"
                               href="/backoffice/envios/@Uri.EscapeDataString(envio.Numero)/evidencias/@firmaId">Ver firma del intento @intento.NumeroIntento</a>
                        }
                        @if (evidencia.FotoArchivoId is { } fotoId)
                        {
                            <a class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener"
                               href="/backoffice/envios/@Uri.EscapeDataString(envio.Numero)/evidencias/@fotoId">Ver foto del intento @intento.NumeroIntento</a>
                        }
                    </div>
                }
                else
                {
                    <p>Sin evidencia registrada.</p>
                }
            </div>
        </article>
    }
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-12 col-lg-6">
<section class="card h-100" aria-labelledby="incidencias-titulo">
    <div class="card-body p-4">
    <h2 id="incidencias-titulo" class="h5 mb-3">Incidencias</h2>
    @if (envio.Incidencias.Count == 0)
    {
        <p>No hay incidencias registradas.</p>
    }
    @foreach (var incidencia in envio.Incidencias)
    {
        <article class="card mb-3">
            <div class="card-body">
                <h3 class="h5">@incidencia.Tipo · @incidencia.Estado</h3>
                <p>@incidencia.Descripcion</p>
                <p>Creada: @Model.MostrarFecha(incidencia.CreadaEn)</p>
                @if (incidencia.ResueltaEn is { } resuelta)
                {
                    <p>Resuelta: @Model.MostrarFecha(resuelta)</p>
                }
                @if (!string.IsNullOrWhiteSpace(incidencia.Resolucion))
                {
                    <p>Resolución: @incidencia.Resolucion</p>
                }
            </div>
        </article>
    }
    </div>
</section>
    </div>
    <div class="col-12 col-lg-6">
<section class="card h-100" aria-labelledby="devolucion-titulo">
    <div class="card-body p-4">
    <h2 id="devolucion-titulo" class="h5 mb-3">Devolución</h2>
    @if (envio.Devolucion is { } devolucion)
    {
        <dl class="row">
            <dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@devolucion.Estado</dd>
            <dt class="col-sm-4">Motivo</dt><dd class="col-sm-8">@devolucion.Motivo</dd>
            <dt class="col-sm-4">Iniciada</dt><dd class="col-sm-8">@Model.MostrarFecha(devolucion.IniciadaEn)</dd>
            <dt class="col-sm-4">Recibida en depósito</dt><dd class="col-sm-8">@(devolucion.RecibidaEnDepositoEn is { } recibida ? Model.MostrarFecha(recibida) : "Sin registrar")</dd>
            <dt class="col-sm-4">Entregada al comercio</dt><dd class="col-sm-8">@(devolucion.EntregadaAlComercioEn is { } entregada ? Model.MostrarFecha(entregada) : "Sin registrar")</dd>
            <dt class="col-sm-4">Receptor</dt><dd class="col-sm-8">@(devolucion.NombreReceptor ?? "Sin informar")</dd>
            <dt class="col-sm-4">Documento</dt><dd class="col-sm-8">@(devolucion.DocumentoReceptor ?? "Sin informar")</dd>
        </dl>
    }
    else
    {
        <p>No hay devolución registrada.</p>
    }
    </div>
</section>
    </div>
</div>

<section aria-labelledby="historial-titulo">
    <div class="card-body p-4">
    <h2 id="historial-titulo" class="h5 mb-2">Historial de eventos</h2>
    <p class="text-muted mb-4">Consultá los cambios de estado y las acciones registradas en este envío.</p>
    @if (envio.Eventos.Count == 0)
    {
        <p>No hay eventos registrados.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Fecha y hora</th>
                        <th scope="col">Estado anterior</th>
                        <th scope="col">Estado nuevo</th>
                        <th scope="col">Origen</th>
                        <th scope="col">Responsable</th>
                        <th scope="col">Ubicación</th>
                        <th scope="col">Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evento in envio.Eventos)
                    {
                        <tr>
                            <td class="text-nowrap">@Model.MostrarFecha(evento.OcurridoEn)</td>
                            <td>@(evento.EstadoAnterior is null ? "Alta del envío" : EstadoEnvioTexto.Mostrar(evento.EstadoAnterior))</td>
                            <td>@EstadoEnvioTexto.Mostrar(evento.EstadoNuevo)</td>
                            <td>@OrigenEventoTexto.Mostrar(evento.Origen)</td>
                            <td class="text-break">@(evento.ResponsableId?.ToString() ?? "Sin informar")</td>
                            <td>
                                @if (evento.Latitud.HasValue && evento.Longitud.HasValue)
                                {
                                    <span>@evento.Latitud, @evento.Longitud</span>
                                }
                                else
                                {
                                    <span>Sin informar</span>
                                }
                            </td>
                            <td>@(evento.Detalle ?? "Sin informar")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
</section>
