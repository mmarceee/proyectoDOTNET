@page "/backoffice/envios"
@model Logistica.Modules.Envios.Presentation.Features.ConsultarEnvios.IndexModel
@using Logistica.Modules.Envios.Domain.Envios
@using Logistica.Modules.Administracion.Contracts
@using Microsoft.AspNetCore.WebUtilities

@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Envíos";
}

<h1 class="mb-4">Envíos</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<form method="get" class="d-flex flex-wrap align-items-end gap-3 mb-3">
    <input type="hidden" name="Pagina" value="1" />
    <input type="hidden"
           name="TamanoPagina"
           value="@Model.Resultado.TamanoPagina" />

    <div>
        <label asp-for="Estado" class="form-label">Estado</label>
        <select asp-for="Estado" class="form-select" onchange="this.form.requestSubmit()">
            <option value="">Todos los estados</option>

            @foreach (var estado in Enum.GetValues<EstadoEnvio>())
            {
                <option value="@estado">@EstadoEnvioTexto.Mostrar(estado.ToString())</option>
            }
        </select>
    </div>

    <div>
        <label asp-for="FechaDesde" class="form-label">Fecha desde</label>
        <input asp-for="FechaDesde"
               type="date"
               class="form-control"
               onchange="this.form.requestSubmit()" />
    </div>

    <div>
        <label asp-for="FechaHasta" class="form-label">Fecha hasta</label>
        <input asp-for="FechaHasta"
               type="date"
               class="form-control"
               onchange="this.form.requestSubmit()" />
    </div>

    <div>
        <label asp-for="Texto" class="form-label">
            Número, referencia o destinatario
        </label>

        <input asp-for="Texto"
               type="search"
               class="form-control"
               placeholder="Escribe y presiona Enter" />
    </div>
    <div>
        <label asp-for="ComercioId" class="form-label">Comercio</label>
        <select asp-for="ComercioId" class="form-select" onchange="this.form.requestSubmit()">
            <option value="">Todas las opciones</option>
            @foreach (var item in Model.Comercios)
            {
                <option value="@item.ComercioId">@item.RazonSocial</option>
            }
        </select>
    </div>

    <div>
        <label asp-for="ZonaId" class="form-label">Zona</label>
        <select asp-for="ZonaId" class="form-select" onchange="this.form.requestSubmit()">
            <option value="">Todas las opciones</option>
            @foreach (var item in Model.Zonas)
            {
                <option value="@item.Id">@item.Nombre</option>
            }
        </select>
    </div>

    <div>
        <label asp-for="Modalidad" class="form-label">Modalidad</label>
        <select asp-for="Modalidad" class="form-select" onchange="this.form.requestSubmit()">
            <option value="">Todas las opciones</option>
            @foreach (var item in Enum.GetValues<Modalidad>())
            {
                <option value="@item">@EstadoEnvioTexto.Modalidad(item.ToString())</option>
            }
        </select>
    </div>

    <div>
        <label asp-for="Resumen" class="form-label">Resumen</label>
        <select asp-for="Resumen" class="form-select" onchange="this.form.requestSubmit()">
            <option value="">Todas las opciones</option>
            @foreach (var item in Enum.GetValues<ResumenEnvio>())
            {
                <option value="@item">@EstadoEnvioTexto.Resumen(item.ToString())</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Buscar</button>

    <a href="/backoffice/envios" class="btn btn-outline-secondary">
        Limpiar filtros
    </a>
</form>
@if (ViewData.ModelState.IsValid)
{
    <p>Total de envíos: @Model.Resultado.TotalRegistros</p>
}
@if (!ViewData.ModelState.IsValid)
{
    <p>Corregí los filtros para consultar los envíos.</p>
}
else if (Model.Resultado.Envios.Count == 0)
{
    <p>No hay envíos para mostrar.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">Número</th>
                    <th scope="col">Referencia</th>
                    <th scope="col">Comercio</th>
                    <th scope="col">Destinatario</th>
                    <th scope="col">Localidad</th>
                    <th scope="col">Zona</th>
                    <th scope="col">Modalidad</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Entrega</th>
                    <th scope="col">Fecha de alta</th>
                    <th scope="col">Monto</th>
                    <th scope="col">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var envio in Model.Resultado.Envios)
                {
                    <tr>
                        <td>@envio.Numero</td>
                        <td>@(envio.ReferenciaComercio ?? "—")</td>
                        <td>@Model.NombreComercio(envio.ComercioId)</td>
                        <td>@envio.DestinatarioNombre</td>
                        <td>@envio.Localidad</td>
                        <td>@Model.NombreZona(envio.ZonaId)</td>
                        <td>
                            @if (envio.Modalidad == "Urgente")
                            {
                                <span class="badge text-bg-warning">Urgente</span>
                            }
                            else
                            {
                                @EstadoEnvioTexto.Modalidad(envio.Modalidad)
                            }
                        </td>
                        <td><span class="badge @EstadoEnvioBadge.Clase(envio.Estado)">@EstadoEnvioTexto.Mostrar(envio.Estado)</span></td>
                        @* RF 31: el resumen derivado de los bultos y el contador de entregados. *@
                        <td>
                            <span class="badge @ResumenEnvioTexto.Clase(envio.Resumen, envio.Terminado, envio.BultosEntregados)">@ResumenEnvioTexto.Mostrar(envio.Resumen, envio.Terminado, envio.BultosEntregados)</span>
                            <div class="small text-body-secondary text-nowrap">@ResumenEnvioTexto.Detalle(envio.Resumen, envio.Terminado, envio.BultosEntregados, envio.TotalBultos)</div>
                        </td>
                        <td>@envio.CreadoEn.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@envio.MontoTarifa.ToString("0.00")</td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-outline-primary btn-sm text-nowrap"
                                   href="@QueryHelpers.AddQueryString($"/backoffice/envios/{Uri.EscapeDataString(envio.Numero)}", Model.ParametrosListado)"
                                   aria-label="Ver detalle del envío @envio.Numero">Ver detalle</a>
                                @if (User.IsInRole("Administrador") || User.IsInRole("Despachador"))
                                {
                                    <a class="btn btn-outline-secondary btn-sm text-nowrap"
                                       href="/backoffice/seguimiento/@Uri.EscapeDataString(envio.Numero)"
                                       aria-label="Ver seguimiento del envío @envio.Numero">Seguimiento</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Resultado.TotalRegistros > 0)
        {
            <nav aria-label="Paginación de envíos"
                 class="d-flex align-items-center gap-3">

                @if (Model.Resultado.Pagina > 1)
                {
                    <a class="btn btn-outline-primary"
                       href="@Model.UrlPagina(Model.Resultado.Pagina - 1)">
                        Anterior
                    </a>
                }

                <span>
                    Página @Model.Resultado.Pagina
                    de @Model.Resultado.TotalPaginas
                </span>

                @if (Model.Resultado.Pagina < Model.Resultado.TotalPaginas)
                {
                    <a class="btn btn-outline-primary"
                       href="@Model.UrlPagina(Model.Resultado.Pagina + 1)">
                        Siguiente
                    </a>
                }
            </nav>
        }
    </div>
}
