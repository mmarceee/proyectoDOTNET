@page "/backoffice/rendiciones"
@model Logistica.Modules.Deposito.Presentation.Features.ConfirmarRendicion.IndexModel

@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Rendiciones";
}

<h1 class="mb-4">Rendiciones @(Model.Confirmadas ? "confirmadas" : "pendientes")</h1>
<nav class="nav nav-pills gap-2 mb-3" aria-label="Estado de rendiciones">
    <a href="/backoffice/rendiciones" class="nav-link @(!Model.Confirmadas ? "active" : "")" aria-current="@(!Model.Confirmadas ? "page" : null)">Pendientes</a>
    <a href="/backoffice/rendiciones?estado=confirmadas" class="nav-link @(Model.Confirmadas ? "active" : "")" aria-current="@(Model.Confirmadas ? "page" : null)">Confirmadas</a>
</nav>
<p class="text-muted">
    @(Model.Confirmadas
        ? "Consultá los cierres anteriores. Desde su detalle podés liberar los envíos no cargados después de verificar que todos sus bultos están en depósito."
        : "Los repartidores declararon qué vuelve al depósito. Elegí una rendición, escaneá lo que llegó y confirmá.")
</p>

@if (Model.Mensaje is not null)
{
    <div class="alert alert-success" role="status">@Model.Mensaje</div>
}

@if (Model.Rendiciones.Count == 0)
{
    <p class="text-muted">No hay rendiciones @(Model.Confirmadas ? "confirmadas" : "pendientes") en esta página.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">Iniciada</th>
                    @if (Model.Confirmadas) { <th scope="col">Confirmada</th> }
                    <th scope="col">Chofer</th>
                    <th scope="col">Vehículo</th>
                    <th scope="col">Bultos que vuelven</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var fila in Model.Rendiciones)
                {
                    var rendicion = fila.Rendicion;
                    <tr>
                        <td>@rendicion.IniciadaEn.ToString("dd/MM/yyyy HH:mm") UTC</td>
                        @if (Model.Confirmadas) { <td>@rendicion.FinalizadaEn?.ToString("dd/MM/yyyy HH:mm") UTC</td> }
                        <td>@fila.Chofer</td>
                        <td class="text-nowrap">@fila.Vehiculo</td>
                        <td>@rendicion.Lineas.Count(l => l.DebeVolver)</td>
                        <td><a href="/backoffice/rendiciones/@rendicion.RutaId" class="btn btn-sm btn-primary">@(Model.Confirmadas ? "Ver detalle" : "Revisar")</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<nav class="d-flex gap-2 mt-3" aria-label="Páginas de rendiciones">
    @if (Model.Pagina > 1)
    {
        <a href="/backoffice/rendiciones?estado=@Model.Estado&pagina=@(Model.Pagina - 1)" class="btn btn-outline-secondary">Anterior</a>
    }
    @if (Model.Rendiciones.Count == 20 && Model.Pagina < 10000)
    {
        <a href="/backoffice/rendiciones?estado=@Model.Estado&pagina=@(Model.Pagina + 1)" class="btn btn-outline-secondary">Siguiente</a>
    }
</nav>
