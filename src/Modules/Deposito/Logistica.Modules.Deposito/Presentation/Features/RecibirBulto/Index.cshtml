@page "/backoffice/deposito/recepcion"
@model Logistica.Modules.Deposito.Presentation.Features.RecibirBulto.IndexModel
@using Logistica.Modules.Deposito.Domain.Recepciones

@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Recepción en depósito";
}

<h1 class="mb-4">Recepción en depósito</h1>
@if (Model.UrlDetalle is { } urlDetalle)
{
    <a href="@urlDetalle" class="btn btn-outline-secondary mb-3">Volver al detalle del envío</a>
}
<p class="text-muted">
    Escaneá el código del bulto. El lector funciona como un teclado: escribe el código y presiona Enter.
    El peso y las medidas son opcionales.
</p>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" asp-validation-summary="All" role="alert"></div>
}

@if (Model.Resultado is { } resultado)
{
    var conforme = resultado.Resultado == ResultadoRecepcion.Conforme;

    <div class="alert @(conforme ? "alert-success" : "alert-warning")" role="status">
        Bulto recibido en el envío <strong>@resultado.NumeroEnvio</strong>:
        @(conforme ? "conforme." : "con discrepancia.")

        @if (resultado.Discrepancia is not null)
        {
            <div>@resultado.Discrepancia</div>
        }

        @if (resultado.EnvioEnDeposito)
        {
            <div class="mt-2"><strong>Llegaron todos los bultos: el envío pasó a estado en Depósito.</strong></div>
        }
    </div>

    <table class="table table-sm w-auto">
        <thead>
            <tr>
                <th scope="col">Bulto</th>
                <th scope="col">Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bulto in resultado.Bultos)
            {
                <tr>
                    <td>@bulto.Codigo</td>
                    <td>@(bulto.Recibido ? "Recibido" : "Pendiente")</td>
                </tr>
            }
        </tbody>
    </table>
}

<form id="formulario-recepcion" method="post" class="row g-3 align-items-end">
    <input type="hidden" asp-for="Pagina" />
    <input type="hidden" asp-for="TamanoPagina" />
    <input type="hidden" asp-for="Estado" />
    <input type="hidden" asp-for="FechaDesde" />
    <input type="hidden" asp-for="FechaHasta" />
    <input type="hidden" asp-for="Texto" />
    <div class="col-md-4">
        <label asp-for="CodigoBulto" class="form-label">Código del bulto</label>
        <input asp-for="CodigoBulto" class="form-control" autofocus autocomplete="off" />
        <span asp-validation-for="CodigoBulto" class="text-danger"></span>
    </div>
    <div class="col-md-2">
        <label asp-for="PesoKg" class="form-label">Peso (kg)</label>
        <input asp-for="PesoKg" type="number" step="0.01" min="0" class="form-control" />
    </div>
    <div class="col-md-2">
        <label asp-for="LargoCm" class="form-label">Largo (cm)</label>
        <input asp-for="LargoCm" type="number" step="0.1" min="0" class="form-control" />
    </div>
    <div class="col-md-2">
        <label asp-for="AnchoCm" class="form-label">Ancho (cm)</label>
        <input asp-for="AnchoCm" type="number" step="0.1" min="0" class="form-control" />
    </div>
    <div class="col-md-2">
        <label asp-for="AltoCm" class="form-label">Alto (cm)</label>
        <input asp-for="AltoCm" type="number" step="0.1" min="0" class="form-control" />
    </div>
    <div class="col-12">
        @if (Model.Diferencias.Count > 0)
        {
            <div class="alert alert-warning" role="alert" aria-labelledby="advertencia-medidas" data-advertencia-recepcion>
                <h2 id="advertencia-medidas" class="h5">Los valores medidos no coinciden con lo declarado por el comercio</h2>
                <p>El bulto <strong>@Model.CodigoBulto</strong> todavía no se registró. Revisá las diferencias y corregí los valores si hubo un error de ingreso.</p>
                <div class="table-responsive">
                    <table class="table table-sm w-auto">
                        <thead><tr><th scope="col">Dato</th><th scope="col">Declarado por el comercio</th><th scope="col">Medido en depósito</th></tr></thead>
                        <tbody>
                            @foreach (var diferencia in Model.Diferencias)
                            {
                                <tr><th scope="row">@diferencia.Nombre</th><td>@diferencia.Declarado.ToString("0.############################") @diferencia.Unidad</td><td>@diferencia.Medido.ToString("0.############################") @diferencia.Unidad</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <input type="hidden" asp-for="ConfirmacionMedidas" />
                <div class="form-check">
                    <input asp-for="ConfirmarDiferencias" class="form-check-input" required />
                    <label asp-for="ConfirmarDiferencias" class="form-check-label">Confirmo que los valores medidos son correctos y difieren de lo declarado por el comercio.</label>
                </div>
            </div>
        }
        <button type="submit" class="btn btn-primary" data-registrar-recepcion>@(Model.Diferencias.Count > 0 ? "Confirmar y registrar" : "Registrar")</button>
    </div>
</form>

@section Scripts {
    <script>
        (() => {
            const formulario = document.getElementById('formulario-recepcion');
            const advertencia = formulario.querySelector('[data-advertencia-recepcion]');
            if (!advertencia) return;
            const confirmacion = formulario.querySelector('#ConfirmarDiferencias');
            const datos = formulario.querySelector('#ConfirmacionMedidas');
            const registrar = formulario.querySelector('[data-registrar-recepcion]');
            formulario.querySelectorAll('#CodigoBulto, #PesoKg, #LargoCm, #AnchoCm, #AltoCm').forEach(campo => {
                campo.addEventListener('input', () => {
                    advertencia.hidden = true;
                    confirmacion.checked = false;
                    confirmacion.required = false;
                    datos.value = '';
                    registrar.textContent = 'Registrar';
                });
            });
        })();
    </script>
}
