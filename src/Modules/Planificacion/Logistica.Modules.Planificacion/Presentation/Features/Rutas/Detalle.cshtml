@page "/backoffice/rutas/{id:guid}"
@model DetalleModel
@{ ViewData["Title"] = "Detalle de ruta"; }
<h1>Ruta del @Model.Ruta?.Fecha.ToString("dd/MM/yyyy")</h1>
<p>Estado: <strong>@Model.Ruta?.Estado</strong> · Revisión @Model.Ruta?.Revision</p>
<h2>Paradas actuales</h2>
<table class="table"><thead><tr><th>Orden</th><th>Envío</th><th>Estado</th></tr></thead><tbody>
@foreach (var parada in Model.Ruta?.Paradas ?? []) { <tr><td>@parada.Orden</td><td>@Model.NumerosEnvio.GetValueOrDefault(parada.EnvioId, "Envío no disponible")</td><td>@parada.Estado</td></tr> }
</tbody></table>
@if (Model.Editable) { @await Html.PartialAsync("~/Presentation/Features/Rutas/Formulario.cshtml", Model) }
<h2>Historial de validaciones</h2>
@foreach (var validacion in Model.Historial)
{
    <details class="mb-3"><summary>@validacion.Operacion · revisión @validacion.RevisionRuta · @validacion.ValidadaEn.ToString("u")</summary>
    <p>Peso: @validacion.Bultos.Sum(b => b.PesoKg) / @validacion.CapacidadPesoKg kg · Volumen: @validacion.Bultos.Sum(b => b.VolumenM3) / @validacion.CapacidadVolumenM3 m³ · Máximo: @validacion.MaxParadas paradas</p>
    <table class="table table-sm"><thead><tr><th>Bulto</th><th>Peso kg</th><th>Dimensiones cm</th></tr></thead><tbody>
    @foreach (var bulto in validacion.Bultos) { <tr><td>@Model.NumerosEnvio.GetValueOrDefault(bulto.EnvioId, "Envío no disponible")</td><td>@bulto.PesoKg</td><td>@bulto.LargoCm × @bulto.AnchoCm × @bulto.AltoCm</td></tr> }
    </tbody></table></details>
}
<a href="/backoffice/rutas">Volver a rutas</a>
