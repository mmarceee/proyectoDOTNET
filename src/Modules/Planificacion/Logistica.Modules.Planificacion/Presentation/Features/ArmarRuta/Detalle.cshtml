@page "/backoffice/rutas/{id:guid}"
@model DetalleModel
@{ ViewData["Title"] = "Detalle de ruta"; }
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1>Ruta del @Model.Ruta?.Fecha.ToString("dd/MM/yyyy")</h1>
        <p class="text-muted mb-0">Estado: <strong>@Model.Ruta?.Estado</strong> · Revisión @Model.Ruta?.Revision</p>
        @if (Model.Ruta?.DespachadaEn is { } despacho)
        {
            <p class="text-muted mb-0">Despachada el @despacho.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</p>
        }
    </div>
    <a href="/backoffice/rutas" class="btn btn-outline-secondary">Volver al listado</a>
</div>
@if (Model.MensajeConfirmacion is { } mensaje)
{
    <div id="resultado-ruta" class="alert alert-success" role="status">@mensaje</div>
}
<section id="paradas-actuales" tabindex="-1" class="card mb-4" aria-labelledby="titulo-paradas-actuales">
<div class="card-body p-4">
<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
    <h2 id="titulo-paradas-actuales" class="h5 mb-0">Paradas actuales</h2>
    @if (Model.Editable)
    {
        <div class="d-flex flex-wrap gap-2">
        @if (Model.Ruta?.Paradas.Count > 0)
        {
            <button type="button" class="btn btn-outline-secondary" data-editar-paradas aria-pressed="false" disabled="@Model.EditandoDatos">Editar paradas</button>
        }
        <button form="formulario-ruta" asp-page-handler="AbrirEnvios" class="btn btn-primary" formnovalidate disabled="@Model.EditandoDatos">Agregar envíos</button>
        </div>
    }
</div>
@foreach (var parada in Model.Ruta?.Paradas ?? [])
{
    <section class="border rounded p-3 mb-3" data-parada-id="@parada.Id">
    <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
        <h3 class="h6 mb-0">Parada @parada.Orden · @parada.Direccion</h3>
        <span class="text-muted">@parada.Envios.Count envíos · @parada.Estado</span>
    </div>
    @if (parada.Desde is { } desde && parada.Hasta is { } hasta)
    { <p class="text-muted mb-2">Horario de la visita: @desde.ToString("HH:mm")–@hasta.ToString("HH:mm")</p> }
    <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Envío</th><th>Estado del envío en la parada</th>@if (Model.Editable) { <th class="text-end" data-accion-quitar hidden>Acciones</th> }</tr></thead><tbody>
    @foreach (var envio in parada.Envios)
    {
        var numero = Model.NumerosEnvio.GetValueOrDefault(envio.EnvioId, "Envío no disponible");
        <tr><td>@numero</td><td>@envio.Estado</td>
        @if (Model.Editable)
        {
            <td class="text-end" data-accion-quitar hidden><button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#quitar-envio" data-envio-id="@envio.EnvioId" data-envio-numero="@numero" aria-label="Quitar envío @numero">Quitar</button></td>
        }
        </tr>
    }
    </tbody></table></div></section>
}
@if (Model.Ruta?.Paradas.Count == 0) { <p class="text-muted text-center py-4">La ruta no tiene envíos. Sus recursos están disponibles.</p> }
</div>
</section>
@await Html.PartialAsync("~/Presentation/Features/DespacharRuta/ConfirmacionDespacho.cshtml", Model)
@if (Model.Editable) { @await Html.PartialAsync("~/Presentation/Features/ArmarRuta/Formulario.cshtml", Model) }
@if (Model.Editable) { @await Html.PartialAsync("~/Presentation/Features/QuitarEnvioDeRuta/ConfirmacionQuitarEnvio.cshtml", Model) }
else { <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div> }
<section class="card mt-5 mb-4" aria-labelledby="historial-validaciones">
<div class="card-body p-4">
<h2 id="historial-validaciones" class="h5">Historial de la ruta</h2>
<p class="text-muted mb-4">Consultá los envíos quitados y las validaciones registradas al confirmar cambios en la ruta.</p>
@if (Model.Retiros.Count > 0)
{
    <h3 class="h6">Envíos quitados</h3>
    @foreach (var retiro in Model.Retiros)
    {
        <div class="border rounded p-3 mb-3" data-retiro-envio="@retiro.EnvioId">
            <strong>Envío @retiro.NumeroEnvio quitado</strong> · revisión @retiro.RevisionRuta · @retiro.OcurridoEn.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)
            <p class="mt-2 mb-0">Era la parada @retiro.OrdenAnterior. El envío volvió a En depósito. @(retiro.ParadasRestantes == 0 ? "La ruta quedó vacía y liberó sus recursos." : $"Quedaron {retiro.ParadasRestantes} paradas y se actualizó su orden.")</p>
        </div>
    }
}
<h3 class="h6">Validaciones de carga</h3>
@if (Model.Historial.Count == 0) { <p class="text-muted mb-0">Todavía no hay validaciones registradas.</p> }
@foreach (var validacion in Model.Historial)
{
    <details class="border rounded p-3 mb-3"><summary>@validacion.Operacion · revisión @validacion.RevisionRuta · @validacion.ValidadaEn.ToOffset(TimeSpan.FromHours(-3)).ToString("dd/MM/yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</summary>
    <p class="mt-3">Peso: @validacion.Bultos.Sum(b => b.PesoKg) / @validacion.CapacidadPesoKg kg · Volumen: @validacion.Bultos.Sum(b => b.VolumenM3) / @validacion.CapacidadVolumenM3 m³ · Máximo: @validacion.MaxParadas paradas</p>
    <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Bulto</th><th>Peso kg</th><th>Dimensiones cm</th></tr></thead><tbody>
    @foreach (var bulto in validacion.Bultos) { <tr><td>@Model.NumerosEnvio.GetValueOrDefault(bulto.EnvioId, "Envío no disponible")</td><td>@bulto.PesoKg</td><td>@bulto.LargoCm × @bulto.AnchoCm × @bulto.AltoCm</td></tr> }
    </tbody></table></div></details>
}
</div>
</section>
