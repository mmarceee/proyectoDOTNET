@page "/backoffice/rutas"
@model IndexModel
@{ ViewData["Title"] = "Rutas"; }
<div class="backoffice-page-header mb-3"><h1>Rutas</h1><a class="btn btn-primary" href="/backoffice/rutas/nueva">Nueva ruta</a></div>
@if (Model.Desarrollo) { <div class="alert alert-warning">Modo de desarrollo sin sesión. Se usa el operador de prueba. Iniciá sesión para trabajar con tu usuario y operador.</div> }
<form method="get" class="d-flex flex-wrap align-items-end gap-3 mb-3">
    <div><label asp-for="Fecha" class="form-label">Fecha</label><input asp-for="Fecha" type="date" class="form-control" onchange="this.form.requestSubmit()" /></div>
    <div><label asp-for="Estado" class="form-label">Estado</label><select asp-for="Estado" class="form-select" onchange="this.form.requestSubmit()">
        <option value="">Todos</option>
        <option value="Planificada">Planificada</option>
        <option value="Despachada">Despachada</option>
        <option value="EnCurso">En curso</option>
        <option value="Finalizada">Finalizada</option>
    </select><span asp-validation-for="Estado" class="text-danger"></span></div>
    <button class="btn btn-outline-primary">Filtrar</button>
    <a href="/backoffice/rutas" class="btn btn-outline-secondary text-nowrap">Limpiar filtros</a>
</form>
<div class="table-responsive">
<table class="table table-hover align-middle"><thead><tr><th>Fecha</th><th>Estado</th><th>Paradas</th><th>Revisión</th><th class="text-end">Acciones</th></tr></thead><tbody>
@foreach (var ruta in Model.Rutas)
{
    <tr>
        <td>@ruta.Fecha.ToString("dd/MM/yyyy")</td><td>@ruta.Estado</td><td>@ruta.Paradas.Count</td><td>@ruta.Revision</td>
        <td class="text-end">
            <a href="/backoffice/rutas/@ruta.Id" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2 text-nowrap" aria-label="Abrir ruta del @ruta.Fecha.ToString("dd/MM/yyyy"), con @ruta.Paradas.Count paradas">
                Abrir ruta <span aria-hidden="true">→</span>
            </a>
        </td>
    </tr>
}
</tbody></table>
</div>
@if (Model.Rutas.Count == 0) { <p>No hay rutas para mostrar.</p> }
