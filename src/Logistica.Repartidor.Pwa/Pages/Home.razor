@page "/"

@using System.Net
@using Logistica.Http.Contracts.Repartidor
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Avisos de rutas</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h1>Avisos de rutas</h1>
        <p class="text-muted mb-0">Consultá las rutas que te asignaron y ya fueron despachadas.</p>
    </div>
    <button class="btn btn-primary" @onclick="ActualizarAsync" disabled="@cargando">Actualizar</button>
</div>

@if (cargando)
{
    <p role="status">Consultando tus avisos…</p>
}
@if (error is not null)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
@if (!cargando && error is null && avisos.Count == 0)
{
    <div class="card"><div class="card-body">
        <h2 class="h5">@(pagina == 1 ? "Todavía no tenés avisos" : "No hay más avisos")</h2>
        <p class="mb-0">@(pagina == 1 ? "Cuando despachen una ruta para vos, el aviso aparecerá aquí. Usá Actualizar para consultar las novedades." : "Volvé a las páginas anteriores para consultar los avisos más recientes.")</p>
    </div></div>
}
@foreach (var aviso in avisos)
{
    <section class="card mb-3" aria-label="Ruta despachada">
        <div class="card-body">
            <span class="badge text-bg-success mb-2">Planificación cerrada</span>
            <h2 class="h4">Ruta del @aviso.FechaRuta.ToString("dd/MM/yyyy")</h2>
            <p>Tenés una ruta despachada para esta fecha. El despachador cerró su planificación.</p>
            @if (aviso.FechaRuta == fechaOperativa) {
                <p><a class="btn btn-outline-primary" href="hoja-de-ruta">Ver mi ruta</a></p>
            }
            <dl class="row mb-0">
                <dt class="col-md-4">Despachada</dt><dd class="col-md-8">@aviso.DespachadaEn.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>
        </div>
    </section>
}
@if (avisos.Count == 20 || pagina > 1)
{
    <nav aria-label="Páginas de avisos" class="d-flex align-items-center gap-3 my-3">
        <button class="btn btn-outline-secondary" @onclick="AnteriorAsync" disabled="@(cargando || pagina == 1)">Más recientes</button>
        <span>Página @pagina</span>
        <button class="btn btn-outline-secondary" @onclick="SiguienteAsync" disabled="@(cargando || avisos.Count < 20)">Más antiguos</button>
    </nav>
}
@if (consultadoEn is not null)
{
    <p class="text-muted small" role="status">Última consulta: @consultadoEn.Value.ToString("dd/MM/yyyy HH:mm").</p>
}

@code {
    private List<AvisoRutaResponse> avisos = [];
    private bool cargando;
    private string? error;
    private int pagina = 1;
    private DateTimeOffset? consultadoEn;
    private DateOnly? fechaOperativa;

    protected override Task OnInitializedAsync() => CargarAsync();
    private async Task ActualizarAsync() { pagina = 1; await CargarAsync(); }
    private async Task AnteriorAsync() { pagina--; await CargarAsync(); }
    private async Task SiguienteAsync() { pagina++; await CargarAsync(); }

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;
        avisos = [];
        try
        {
            fechaOperativa = null;
            using var sesion = await Http.GetAsync("/api/repartidor/sesion");
            if (sesion.IsSuccessStatusCode)
                fechaOperativa = (await sesion.Content.ReadFromJsonAsync<SesionRepartidorResponse>())?.FechaOperativa;
            using var response = await Http.GetAsync($"/api/repartidor/avisos?pagina={pagina}");
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo("/repartidor/ingresar", forceLoad: true);
                return;
            }
            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                error = "Tu sesión no tiene acceso a los avisos de un repartidor. Iniciá sesión con tu cuenta de repartidor.";
                return;
            }
            response.EnsureSuccessStatusCode();
            avisos = await response.Content.ReadFromJsonAsync<List<AvisoRutaResponse>>() ?? [];
            consultadoEn = DateTimeOffset.Now;
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            error = "No pudimos consultar tus avisos. Comprobá la conexión y volvé a intentarlo con Actualizar.";
        }
        finally { cargando = false; }
    }
}
