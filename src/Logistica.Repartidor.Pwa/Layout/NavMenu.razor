@using Logistica.Http.Contracts.Repartidor
@inject HttpClient Http

<nav class="navbar navbar-expand-md navbar-dark" aria-label="Navegación principal">
    <div class="container">
        <a class="navbar-brand" href="">VoluptaExpress</a>
        <button type="button" class="navbar-toggler" aria-label="Mostrar navegación"
                aria-controls="main-navigation" aria-expanded="@(!collapseNavMenu ? "true" : "false")"
                @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div id="main-navigation" class="navbar-collapse @(collapseNavMenu ? "collapse" : null)">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseNavMenu">Mis rutas</NavLink>
                </li>
            </ul>
            <div class="cuenta-usuario">
                @if (!string.IsNullOrWhiteSpace(nombreUsuario))
                {
                    <span class="navbar-text">@nombreUsuario</span>
                }
                <a class="btn btn-sm btn-logout" href="/cuenta/salir?repartidor=true">Cerrar sesión</a>
            </div>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private string? nombreUsuario;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var limite = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            using var respuesta = await Http.GetAsync("/api/repartidor/sesion", limite.Token);
            if (respuesta.IsSuccessStatusCode)
                nombreUsuario = (await respuesta.Content.ReadFromJsonAsync<SesionRepartidorResponse>(limite.Token))?.NombreUsuario;
        }
        catch (Exception e) when (e is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // La navegación también debe estar disponible sin conexión.
        }
    }

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private void CloseNavMenu() => collapseNavMenu = true;
}
