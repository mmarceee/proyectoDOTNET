@inherits LayoutComponentBase
@inject Logistica.Repartidor.Pwa.Services.CargaService Cargas
@inject Logistica.Repartidor.Pwa.Services.SeguimientoPosicionService Seguimiento
@implements IDisposable
<div class="page">
    <header>
        <NavMenu />
    </header>
    <main class="container content">
        @if (Seguimiento.Estado is not null)
        {
            <div class="alert alert-info py-2" role="status">@Seguimiento.Estado</div>
        }
        @Body
    </main>
    <footer class="app-footer border-top text-muted">
        <div class="container">&copy; 2026 - VoluptaExpress</div>
    </footer>
</div>
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Seguimiento.Cambio += ActualizarSeguimiento;
            await Seguimiento.InicializarAsync();
            await Cargas.SincronizarAsync();
        }
    }
    private void ActualizarSeguimiento() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Seguimiento.Cambio -= ActualizarSeguimiento;
}
