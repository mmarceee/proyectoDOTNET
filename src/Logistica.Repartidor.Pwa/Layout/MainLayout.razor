@inherits LayoutComponentBase
@inject Logistica.Repartidor.Pwa.Services.CargaService Cargas
<div class="page">
    <header>
        <NavMenu />
    </header>
    <main class="container content">
        @Body
    </main>
    <footer class="app-footer border-top text-muted">
        <div class="container">&copy; 2026 - VoluptaExpress</div>
    </footer>
</div>
@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Cargas.SincronizarAsync();
    }
}
