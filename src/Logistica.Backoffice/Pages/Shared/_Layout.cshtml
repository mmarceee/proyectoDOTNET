<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Backoffice</title>
    <link rel="stylesheet" href="~/_content/Logistica.Backoffice/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/_content/Logistica.Backoffice/css/site.css" asp-append-version="true" />
    @* La marca del operador de la sesión (CU-07): va última para pisar los colores por defecto. *@
    <link rel="stylesheet" href="/cuenta/estilo.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-xxl navbar-light bg-white border-bottom box-shadow mb-3" aria-label="Navegación principal">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/backoffice">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <img src="/cuenta/logo" alt="" height="28" onerror="this.remove()" />
                    }
                    Backoffice
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation"
                        aria-expanded="false" aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="main-navigation" class="navbar-collapse collapse justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("UsuarioComercio")
                        && (User.IsInRole("Administrador") || User.IsInRole("Despachador") || User.IsInRole("OperarioDeposito")))
                    {
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/backoffice">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/backoffice/envios">Envíos</a>
                        </li>
                        @if (User.IsInRole("OperarioDeposito"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/deposito/recepcion">Recepción</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/rendiciones">Rendiciones</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/devoluciones">Devoluciones</a>
                            </li>
                        }
                        @if (User.IsInRole("Despachador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/rutas">Rutas</a>
                            </li>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/comercios">Comercios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/usuarios">Usuarios</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/zonas">Zonas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/tarifario">Tarifario</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/reglas">Reglas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/identidad-visual">Identidad visual</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/mensajes-fallidos">Mensajes fallidos</a>
                            </li>
                        }
                    </ul>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="cuenta-usuario d-flex flex-wrap align-items-center gap-2">
                            <span class="navbar-text">@User.Identity.Name</span>
                            <form method="post" action="/cuenta/salir" asp-antiforgery="true" class="m-0">
                                <button type="submit" class="btn btn-outline-secondary btn-sm btn-logout">Cerrar sesión</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - VoluptaExpress
        </div>
    </footer>

    <script src="~/_content/Logistica.Backoffice/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/_content/Logistica.Backoffice/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/Logistica.Backoffice/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
