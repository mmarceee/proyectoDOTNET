<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Backoffice</title>
    <link rel="stylesheet" href="~/_content/Logistica.Backoffice/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/_content/Logistica.Backoffice/css/site.css" asp-append-version="true" />
    @* La marca del operador de la sesión (CU-07): va última para pisar los colores por defecto. *@
    <link rel="stylesheet" href="/cuenta/estilo.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/backoffice">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <img src="/cuenta/logo" alt="" height="28" onerror="this.remove()" />
                    }
                    Backoffice
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("UsuarioComercio"))
                    {
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/backoffice">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/backoffice/envios">Envíos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/backoffice/deposito/recepcion">Recepción</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/backoffice/rutas">Rutas</a>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/backoffice/identidad-visual">Identidad visual</a>
                            </li>
                        }
                    </ul>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="navbar-text">@User.Identity.Name</span>
                            <form method="post" action="/cuenta/salir" asp-antiforgery="true" class="m-0">
                                <button type="submit" class="btn btn-outline-secondary btn-sm btn-logout">Cerrar sesión</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - VoluptaExpress
        </div>
    </footer>

    <script src="~/_content/Logistica.Backoffice/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/_content/Logistica.Backoffice/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/_content/Logistica.Backoffice/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
